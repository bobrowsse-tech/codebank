{
  "name": "codebank-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first bank of reusable code: a VS Code extension, CLI, and MCP server.",
  "license": "MIT",
  "author": "Bob Rowsse Walakira <hello@bobrowsse.com>",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit --pretty false && node scripts/bundle.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:ext": "npm run build && node scripts/extension-test.mjs",
    "package": "npm run build && npm run package --workspace packages/vscode",
    "dev:cli": "node packages/cli/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "@types/vscode": "^1.101.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
